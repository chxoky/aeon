        "variant": "lead"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event_label",
        "author_msg"
      ]
    },
    "event_label": {
      "type": "Text",
      "props": {
        "text": "Event: supporting-channel message, context unclear",
        "variant": "body"
      }
    },
    "author_msg": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "author_name",
        "quote_text"
      ]
