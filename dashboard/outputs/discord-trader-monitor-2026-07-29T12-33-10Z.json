      "type": "Card",
      "props": {
        "title": "Discord Trader Monitor"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_context",
        "sep1",
        "event_section",
        "sep2",
        "unclear_alert",
        "meanings_stack"
      ]
