        "text": "pre-positioning for chart pattern?",
        "variant": "body"
      }
    },
    "meaning2": {
      "type": "Text",
      "props": {
        "text": "preliminary analysis?",
        "variant": "body"
      }
    },
    "meaning3": {
      "type": "Text",
      "props": {
        "text": "pre-charting before trade?",
        "variant": "body"
      }
    }
