    "author_name": {
      "type": "Text",
      "props": {
        "text": "heartcanhodl:",
        "variant": "caption"
      }
    },
    "quote_text": {
      "type": "Text",
      "props": {
        "text": "\"Pre plot, maybe\"",
        "variant": "body"
      }
    },
