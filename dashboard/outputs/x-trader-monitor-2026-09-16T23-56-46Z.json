{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor",
        "description": "Calibration & Event Analysis"
      },
      "children": [
        "main_stack"
      ]
    },
    "main_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "header",
        "sep1",
        "event_heading",
        "event_section",
        "sep2",
        "tweet",
        "sep3",
        "classification"
      ]
    },
    "header": {
      "type": "Text",
      "props": {
        "text": "🔍 Calibration — @Wild_Randomness",
        "variant": "lead"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event_heading": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event_text",
        "event_badge"
      ]
    },
    "event_text": {
      "type": "Text",
      "props": {
        "text": "Reply to @_tolks (external context unknown)"
      }
    },
    "event_badge": {
      "type": "Badge",
      "props": {
        "text": "FOMC same-day decision context (Sep 16 16:00Z Federal Reserve announcement)",
        "variant": "outline"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "tweet": {
      "type": "TweetCard",
      "props": {
        "author": "Wild_Randomness",
        "handle": "@Wild_Randomness",
        "text": "It's a positive step, let's see if the market runs with it"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "classification": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "message": "What's your read? Does 'positive step' refer to Fed decision, geopolitical event, or market structure development?",
        "type": "warning"
      }
    }
  }
}
