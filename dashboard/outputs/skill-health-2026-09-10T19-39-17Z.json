{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Skill Health"
      },
      "children": [
        "stack-content"
      ]
    },
    "stack-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "text-date",
        "alert-health",
        "separator-1",
        "stack-metrics"
      ]
    },
    "text-date": {
      "type": "Text",
      "props": {
        "text": "2026-09-10",
        "variant": "caption"
      }
    },
    "alert-health": {
      "type": "Alert",
      "props": {
        "title": "HEALTH: OK",
        "message": "8 skills healthy",
        "type": "success"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack-metrics": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat-open-issues",
        "stat-resolved"
      ]
    },
    "stat-open-issues": {
      "type": "Stat",
      "props": {
        "label": "Open issues",
        "value": "0"
      }
    },
    "stat-resolved": {
      "type": "Stat",
      "props": {
        "label": "Resolved this run",
        "value": "0"
      }
    }
  }
}
