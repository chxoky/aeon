{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor"
      },
      "children": [
        "calibration-header",
        "separator-1",
        "event-section",
        "separator-2",
        "quote-section",
        "separator-3",
        "classification-alert"
      ]
    },
    "calibration-header": {
      "type": "Text",
      "props": {
        "text": "🔍 Calibration — [DC: Chase — Crypto]",
        "variant": "muted"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event-heading",
        "event-text"
      ]
    },
    "event-heading": {
      "type": "Heading",
      "props": {
        "text": "Event: Market context",
        "level": "h3"
      }
    },
    "event-text": {
      "type": "Text",
      "props": {
        "text": "BTC in 60–67K consolidation (mixed trader lean, increasingly bullish on dips); Chase flat on BTC with resting bids below.",
        "variant": "body"
      }
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "quote-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "quote-label",
        "quote-value"
      ]
    },
    "quote-label": {
      "type": "Heading",
      "props": {
        "text": "crypto_chase",
        "level": "h4"
      }
    },
    "quote-value": {
      "type": "Text",
      "props": {
        "text": "bitcoin only asset up",
        "variant": "lead"
      }
    },
    "separator-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "classification-alert": {
      "type": "Alert",
      "props": {
        "title": "Classification uncertainty",
        "message": "Unable to classify — what's the read? Market sentiment observation on current asset performance, position conviction statement, or something else?",
        "type": "info"
      }
    }
  }
}
