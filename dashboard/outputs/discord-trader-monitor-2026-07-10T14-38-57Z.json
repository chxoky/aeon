    "opt1": {
      "type": "Text",
      "props": {
        "text": "Is this expressing doubt about a technical setup?",
        "variant": "body"
      }
    },
    "opt2": {
      "type": "Text",
      "props": {
        "text": "Is this expressing doubt about market structure?",
        "variant": "body"
      }
    },
    "opt3": {
      "type": "Text",
      "props": {
        "text": "Is this expressing doubt about chart pattern?",
        "variant": "body"
      }
    }
