    "card_main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor",
        "description": "Message classification calibration"
      },
      "children": [
        "heading",
        "sep1",
        "context_stack",
        "sep2",
        "message_stack",
        "sep3",
        "classification_stack"
      ]
    },
    "heading": {
