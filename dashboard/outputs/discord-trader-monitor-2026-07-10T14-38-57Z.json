    },
    "context_label": {
      "type": "Text",
      "props": {
        "text": "Context:",
        "variant": "lead"
      }
    },
    "context_value": {
      "type": "Text",
      "props": {
        "text": "Supporting-channel message with chart attachment",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "message_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "message_title",
        "message_content"
      ]
    },
    "message_title": {
      "type": "Text",
      "props": {
        "text": "Message Data:",
        "variant": "lead"
      }
    },
    "message_content": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
