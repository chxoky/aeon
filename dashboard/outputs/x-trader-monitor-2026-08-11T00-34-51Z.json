{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "X Trader Monitor",
        "description": "Trading signals and macro thesis tracking"
      },
      "children": [
        "tweet-stack",
        "separator-1",
        "context-stack"
      ]
    },
    "tweet-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "tweet-card",
        "tweet-link"
      ]
    },
    "tweet-card": {
      "type": "TweetCard",
      "props": {
        "author": "trading_axe",
        "handle": "@trading_axe",
        "text": "4K being the bottom on GOLD is further proof that we live in a simulation.\n\n4K Karat Gold.\n\n~ Dr. Axius."
      }
    },
    "tweet-link": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://x.com/trading_axe/status/2086973257236848971"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "context-title",
        "thesis-text",
        "activity-title",
        "activity-list",
        "watch-list-text"
      ]
    },
    "context-title": {
      "type": "Heading",
      "props": {
        "text": "Context",
        "level": "h3"
      }
    },
    "thesis-text": {
      "type": "Text",
      "props": {
        "text": "Aligns with trading_axe's macro thesis (gold double-bottom vs BTC by year-end).",
        "variant": "body"
      }
    },
    "activity-title": {
      "type": "Heading",
      "props": {
        "text": "Cross-Trader GOLD Activity",
        "level": "h3"
      }
    },
    "activity-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "activity-1",
        "activity-2"
      ]
    },
    "activity-1": {
      "type": "Text",
      "props": {
        "text": "KillaXBT SHORT (Aug 09, active)",
        "variant": "body"
      }
    },
    "activity-2": {
      "type": "Text",
      "props": {
        "text": "Wild_Randomness LONG (Aug 10, re-leveraged)",
        "variant": "body"
      }
    },
    "watch-list-text": {
      "type": "Text",
      "props": {
        "text": "Contested positioning on Kyle's watch list.",
        "variant": "muted"
      }
    }
  }
