      "children": [
        "ticker_unclear",
        "asset_question"
      ]
    },
    "ticker_unclear": {
      "type": "Alert",
      "props": {
        "title": "Ticker Unclear",
        "message": "\"90\" likely price level, unclear which asset — what's your read?",
        "type": "warning"
      }
    },
    "asset_question": {
      "type": "Text",
      "props": {
        "text": "Is this about BTC, another crypto, or equities?",
        "variant": "lead"
      }
    }
  }
}
