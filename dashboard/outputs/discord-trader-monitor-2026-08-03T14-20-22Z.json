{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "🔍 Calibration — DC: HCH Chat"
      },
      "children": [
        "stack-main"
      ]
    },
    "stack-main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event-heading",
        "event-text",
        "sep-1",
        "message-stack",
        "sep-2",
        "status-alert"
      ]
    },
    "event-heading": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "event-text": {
      "type": "Text",
      "props": {
        "text": "Single cryptic one-word message in supporting channel with no context",
        "variant": "body"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "message-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "author-text",
        "message-text"
      ]
    },
    "author-text": {
      "type": "Text",
      "props": {
        "text": "HeartCanHodl",
        "variant": "lead"
      }
    },
    "message-text": {
      "type": "Text",
      "props": {
        "text": "\"How?\"",
        "variant": "body"
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "status-alert": {
      "type": "Alert",
      "props": {
        "title": "Classification Status",
        "message": "Unable to classify — what's your read?",
        "type": "warning"
      }
    }
  }
}
