{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "tweet-section",
        "separator-1",
        "analysis-section"
      ]
    },
    "tweet-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "tweet-card",
        "view-tweet-link"
      ]
    },
    "tweet-card": {
      "type": "TweetCard",
      "props": {
        "author": "Stoiiic",
        "handle": "Stoiiic",
        "text": "ENA had two straight days of continuous buying and finally retraced a bit today.\n\nOn the weekly, previous highs need to hold to trade into the airgap above."
      }
    },
    "view-tweet-link": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://x.com/Stoiiic/status/2090979427563835819"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "analysis-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "technical-heading",
        "technical-details",
        "context-heading",
        "context-text"
      ]
    },
    "technical-heading": {
      "type": "Heading",
      "props": {
        "text": "Technical Analysis",
        "level": "h3"
      }
    },
    "technical-details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "weekly-chart-text",
        "capitulation-low",
        "support-level",
        "airgap-note"
      ]
    },
    "weekly-chart-text": {
      "type": "Text",
      "props": {
        "text": "Weekly chart shows capitulation low (~0.08-0.16), recent 2-day recovery bounce.",
        "variant": "body"
      }
    },
    "capitulation-low": {
      "type": "Stat",
      "props": {
        "label": "Capitulation Low",
        "value": "~0.08–0.16"
      }
    },
    "support-level": {
      "type": "Stat",
      "props": {
        "label": "Key Support (Yearly Open)",
        "value": "0.20000"
      }
    },
    "airgap-note": {
      "type": "Text",
      "props": {
        "text": "Airgap target above if support held.",
        "variant": "caption"
      }
    },
    "context-heading": {
      "type": "Heading",
      "props": {
        "text": "Cross-Trader Context",
        "level": "h4"
      }
    },
    "context-text": {
      "type": "Text",
      "props": {
        "text": "trading_axe mentioned ENA as exemplar of ETH-beta repricing (Aug 21); Stoiiic technical confirmation of accumulation structure.",
        "variant": "body"
      }
    }
  }
}
