{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "heartbeat"
      },
      "children": [
        "main_stack"
      ]
    },
    "main_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "alert",
        "badges_row",
        "separator1",
        "details_stack"
      ]
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "trader-memory-compact not dispatched",
        "message": "No entry in cron-state.json — never dispatched",
        "type": "warning"
      }
    },
    "badges_row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_p3",
        "badge_enabled"
      ]
    },
    "badge_p3": {
      "type": "Badge",
      "props": {
        "text": "P3",
        "variant": "outline"
      }
    },
    "badge_enabled": {
      "type": "Badge",
      "props": {
        "text": "Enabled",
        "variant": "secondary"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "details_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "schedule_text",
        "window_text",
        "recommendation_text"
      ]
    },
    "schedule_text": {
      "type": "Text",
      "props": {
        "text": "Schedule: Sundays 20:00 UTC"
      }
    },
    "window_text": {
      "type": "Text",
      "props": {
        "text": "Next window: 2026-07-27T20:00 UTC",
        "variant": "lead"
      }
    },
    "recommendation_text": {
      "type": "Text",
      "props": {
        "text": "If recently enabled, first run will self-resolve; otherwise check the scheduler.",
        "variant": "caption"
      }
    }
  }
}
