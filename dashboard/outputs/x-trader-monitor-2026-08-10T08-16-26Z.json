      "children": [
        "poss-1",
        "poss-2",
        "poss-3"
      ]
    },
    "poss-1": {
      "type": "Text",
      "props": {
        "text": "A truncated tweet (text cut off mid-sentence)",
        "variant": "muted"
      }
    },
    "poss-2": {
      "type": "Text",
      "props": {
        "text": "A reference to external context",
        "variant": "muted"
      }
    },
    "poss-3": {
      "type": "Text",
      "props": {
        "text": "A call-and-response expecting reply",
        "variant": "muted"
      }
    },
    "classification-alert": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
