      }
    },
    "event-author": {
      "type": "Badge",
      "props": {
        "text": "@Bitcoin_Astro",
        "variant": "outline"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "tweet-section": {
      "type": "TweetCard",
      "props": {
        "author": "Bitcoin_Astro",
        "handle": "Bitcoin_Astro",
        "text": "#Bitcoin\nAre you"
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "analysis-section": {
      "type": "Stack",
