      "children": [
        "event-section",
        "sep-1",
        "tweet-section",
        "sep-2",
        "analysis-section"
      ]
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event-text",
        "event-author"
      ]
    },
    "event-text": {
      "type": "Text",
      "props": {
        "text": "Event: Bitcoin_Astro post (Aug 10 08:12:31Z)",
