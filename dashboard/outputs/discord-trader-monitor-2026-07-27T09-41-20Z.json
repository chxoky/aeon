        "channel-info",
        "timestamp-info",
        "wick-reference",
        "risk-assessment"
      ]
    },
    "channel-info": {
      "type": "Text",
      "props": {
        "text": "Channel: Discord Chat (supporting)",
        "variant": "body"
      }
    },
    "timestamp-info": {
      "type": "Text",
      "props": {
        "text": "Timestamp: Jul 27 09:37Z",
        "variant": "body"
      }
    },
    "wick-reference": {
      "type": "Text",
      "props": {
        "text": "Cryptic reference to 'that wick' (completed price action?)",
        "variant": "body"
      }
    },
    "risk-assessment": {
      "type": "Badge",
      "props": {
        "text": "Warning: Risky to short, late entry",
        "variant": "destructive"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "escalation-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "escalation-heading",
        "escalation-items"
      ]
    },
    "escalation-heading": {
      "type": "Heading",
      "props": {
        "text": "Recent Short Basket Escalation",
        "level": "h3"
      }
    },
    "escalation-items": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "eth-add",
        "zec-add",
