{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor",
        "description": "Discord Chat Channel Calibration — HeartCanHodl Market Analysis"
      },
      "children": [
        "calibration-heading",
        "sep1",
        "quote-card",
        "sep2",
        "context-section",
        "sep3",
        "escalation-section",
        "sep4",
        "analysis-section"
      ]
    },
    "calibration-heading": {
      "type": "Heading",
      "props": {
        "text": "🔍 Calibration — [DC: HCH — Chat]",
        "level": "h2"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "quote-card": {
      "type": "TweetCard",
      "props": {
        "author": "HeartCanHodl",
