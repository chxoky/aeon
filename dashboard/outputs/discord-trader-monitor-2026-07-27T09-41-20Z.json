    "zec-add": {
      "type": "Badge",
      "props": {
        "text": "ZEC +3%",
        "variant": "default"
      }
    },
    "kaito-entry": {
      "type": "Badge",
      "props": {
        "text": "Kaito Entry",
        "variant": "default"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "analysis-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "analysis-heading",
        "classification-options"
      ]
