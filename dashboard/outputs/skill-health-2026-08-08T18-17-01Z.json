{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Skill Health — 2026-08-08"
      },
      "children": [
        "status_stack"
      ]
    },
    "status_stack": {
