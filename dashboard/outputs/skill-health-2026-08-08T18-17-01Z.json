        "orientation": "horizontal"
      },
      "children": []
    },
    "stats_grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "stat_open_issues",
        "stat_resolved"
      ]
    },
    "stat_open_issues": {
      "type": "Stat",
      "props": {
        "label": "Open issues",
        "value": "1"
      },
      "children": []
    },
    "stat_resolved": {
      "type": "Stat",
      "props": {
        "label": "Resolved this run",
        "value": "0"
      },
      "children": []
    }
