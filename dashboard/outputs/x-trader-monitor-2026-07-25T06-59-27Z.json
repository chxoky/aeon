    "game_data_heading": {
      "type": "Heading",
      "props": {
        "text": "Protocol Game Data",
        "level": "h3"
      }
    },
    "game_stats": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat_payout",
        "stat_profitable",
        "stat_players"
