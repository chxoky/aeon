    "stat_profitable": {
      "type": "Stat",
      "props": {
        "label": "Profitable Players",
        "value": "13%"
      }
    },
    "stat_players": {
      "type": "Stat",
      "props": {
        "label": "Total Players",
        "value": "975"
      }
    },
    "game_context": {
      "type": "Text",
      "props": {
        "text": "Single-trader mention but gaining broader market attention.",
        "variant": "muted"
      }
    },
    "link_tweet": {
      "type": "Link",
      "props": {
        "label": "View tweet",
