      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "tweet_card",
        "sep1",
        "game_data_section",
        "link_tweet"
      ]
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "bull_genius",
        "handle": "bull_genius",
        "text": "FWA market sentiment — whole crypto twitter is talking about it. Jack Butcher released a product drop, and marmot got sidelined. Trader expresses FOMO about missing the move: 'should have continued ripping tho 😅'"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "game_data_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "game_data_heading",
        "game_stats",
        "game_context"
      ]
