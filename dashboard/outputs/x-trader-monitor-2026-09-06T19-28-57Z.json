        "variant": "body"
      }
    },
    "q3": {
      "type": "Text",
      "props": {
        "text": "3. Financial signal or noise?",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "action_section": {
      "type": "Alert",
      "props": {
        "title": "Reply with context",
