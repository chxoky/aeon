        "sep1",
        "problem_section",
        "sep2",
        "context_section",
        "sep3",
        "action_section"
      ]
    },
    "calibration_meta": {
      "type": "Text",
      "props": {
        "text": "🔍 Calibration — @Wild_Randomness",
        "variant": "muted"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "problem_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "problem_heading",
        "tweet_card",
        "url_link"
