      "props": {
        "author": "Wild_Randomness",
        "handle": "@Wild_Randomness",
        "text": "@fejau_inc yep"
      }
    },
    "url_link": {
      "type": "Link",
      "props": {
        "label": "View on X",
        "href": "https://x.com/Wild_Randomness/status/2096681325604561350"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
