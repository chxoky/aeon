{
  "root": "main_card",
  "state": {},
  "elements": {
    "main_card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "header_section",
        "sep0",
        "event_section",
        "tweet_card",
        "sep1",
        "issue_section"
      ]
    },
    "header_section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "header_emoji_text",
        "author_link"
      ]
    },
    "header_emoji_text": {
      "type": "Text",
      "props": {
        "text": "🔍 Calibration —",
        "variant": "lead"
      }
    },
    "author_link": {
      "type": "Link",
      "props": {
        "label": "@t_in_crypto",
        "href": "https://x.com/t_in_crypto"
      }
    },
    "sep0": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event_heading",
        "event_reply_section"
      ]
    },
    "event_heading": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "event_reply_section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "event_reply_text_part",
        "bnshiv_link"
      ]
    },
    "event_reply_text_part": {
      "type": "Text",
      "props": {
        "text": "Reply to"
      }
    },
    "bnshiv_link": {
      "type": "Link",
      "props": {
        "label": "@bnshiv23",
        "href": "https://x.com/bnshiv23"
      }
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "t_in_crypto",
        "handle": "@t_in_crypto",
        "text": "Everything will be just like that, don't worry Wd won't see 80+ for a long time"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "issue_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "issue_alert",
        "questions_section",
        "link_section"
      ]
    },
    "issue_alert": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "message": "What's your read on 'Wd 80+'?",
        "type": "warning"
      }
    },
    "questions_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "q_intro",
        "q1",
        "q2"
      ]
    },
    "q_intro": {
      "type": "Text",
      "props": {
        "text": "Considerations:",
        "variant": "lead"
      }
    },
    "q1": {
      "type": "Text",
      "props": {
        "text": "• Does WD refer to a ticker or price level?"
      }
    },
    "q2": {
      "type": "Text",
      "props": {
        "text": "• What's the financial context/conviction?"
      }
    },
    "link_section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "link_to_post"
      ]
    },
    "link_to_post": {
      "type": "Link",
      "props": {
        "label": "View post",
        "href": "https://x.com/t_in_crypto/status/2079709851509297321"
      }
    }
  }
}
