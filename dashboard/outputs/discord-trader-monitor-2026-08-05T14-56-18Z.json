        "text": "'Fc' could mean 'Force close'"
      }
    },
    "interp_xaut": {
      "type": "Text",
      "props": {
        "text": "'XAUT' is gold"
      }
    },
    "interp_1d": {
      "type": "Text",
      "props": {
