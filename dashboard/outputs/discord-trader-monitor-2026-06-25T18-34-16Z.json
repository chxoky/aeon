    "msgid-key": {
      "type": "Text",
      "props": {
        "text": "Message ID:",
        "variant": "caption"
      }
    },
    "msgid-val": {
      "type": "Text",
      "props": {
        "text": "1519772013466484898",
        "variant": "body"
      }
    },
    "time-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "time-key",
        "time-val"
