{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "Discord Trader Monitor"
      },
      "children": [
        "calibration-section",
        "sep-1",
        "message-section",
        "sep-2",
        "metadata-section",
        "sep-3",
        "caveat-alert"
      ]
    },
    "calibration-section": {
      "type": "Stack",
