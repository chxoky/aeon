    "cal-badge": {
      "type": "Badge",
      "props": {
        "text": "DC: Chase — TradFi",
        "variant": "secondary"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "message-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "msg-label",
        "msg-text",
        "msg-attachment"
      ]
    },
    "msg-label": {
      "type": "Text",
      "props": {
        "text": "Message",
        "variant": "lead"
