    "stat-days": {
      "type": "Stat",
      "props": {
        "label": "Days since last successful run",
        "value": "36",
        "trend": "down"
      },
      "children": []
    },
    "text-lastrun": {
      "type": "Text",
      "props": {
        "text": "Last successful run: 2026-06-08"
      },
      "children": []
