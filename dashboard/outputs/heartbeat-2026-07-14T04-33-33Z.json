{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Aeon Heartbeat",
        "description": "System health check — first run since Jun 8"
      },
      "children": [
        "alert-critical",
        "sep1",
        "stack-incident",
        "sep2",
        "stack-affected",
        "sep3",
        "stack-fix",
        "sep4",
        "stack-health"
      ]
    },
    "alert-critical": {
      "type": "Alert",
      "props": {
        "type": "error",
        "title": "🔴 GitHub Actions Scheduled Crons Not Firing",
        "message": "Every run in the last ~5 weeks was workflow_dispatch (Worker webhooks + manual triggers only). No scheduled cron executions detected."
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "stack-incident": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-incident",
        "stat-days",
        "text-lastrun"
      ]
    },
    "heading-incident": {
      "type": "Heading",
      "props": {
        "text": "Outage Timeline",
        "level": "h3"
      },
      "children": []
