        "text": "HCH reply to own message (frustration/market commentary)",
        "variant": "caption"
      }
    },
    "original-msg-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "orig-label",
        "orig-msg"
      ]
