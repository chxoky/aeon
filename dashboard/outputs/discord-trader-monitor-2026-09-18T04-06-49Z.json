      }
    },
    "analysis-block": {
      "type": "Text",
      "props": {
        "text": "Unable to classify",
        "variant": "caption"
      }
    },
    "classification-alert": {
      "type": "Alert",
      "props": {
        "title": "Classification Needed",
        "message": "What's your read?",
        "type": "info"
      }
