    "discord-ref": {
      "type": "Link",
      "props": {
        "label": "[Discord ref link]",
        "href": ""
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
