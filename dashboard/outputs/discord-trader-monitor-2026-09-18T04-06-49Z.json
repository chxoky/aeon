        "sep-1",
        "event-section",
        "sep-2",
        "context-section"
      ]
    },
    "cal-section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "cal-icon",
        "cal-label",
        "cal-badge"
      ]
    },
    "cal-icon": {
      "type": "Text",
      "props": {
        "text": "🔍",
        "variant": "lead"
      }
    },
    "cal-label": {
      "type": "Text",
      "props": {
        "text": "Calibration",
        "variant": "body"
      }
