    },
    "orig-msg": {
      "type": "Text",
      "props": {
        "text": "One of those days 👽",
        "variant": "lead"
      }
    },
    "reply-msg-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
