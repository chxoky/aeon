{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor",
        "description": "Calibration Review"
      },
      "children": [
        "content-stack"
      ]
    },
    "content-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "calibration-heading",
        "separator1",
        "event-section",
        "separator2",
        "alert"
      ]
    },
    "calibration-heading": {
      "type": "Heading",
      "props": {
        "text": "🔍 Calibration — @swarmister",
        "level": "h2"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event-description",
        "tweet",
        "classification-question"
      ]
    },
    "event-description": {
      "type": "Text",
      "props": {
        "text": "Event: Reply to @flim_flamdegen (original message not visible in payload)",
        "variant": "lead"
      }
    },
    "tweet": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
        "text": "Why not"
      }
    },
    "classification-question": {
      "type": "Text",
      "props": {
        "text": "Unable to classify — what's your read?",
        "variant": "muted"
      }
    },
    "separator2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "Classification Needed",
        "message": "Unable to automatically classify this interaction. Awaiting manual review.",
        "type": "warning"
      }
    }
  }
}
