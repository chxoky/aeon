      }
    },
    "chart_context": {
      "type": "Text",
      "props": {
        "text": "Chart shows capitulation crash from $225.75 → $194.84, with entry at bottom after liquidation cascade.",
        "variant": "caption"
      }
    },
    "post_link": {
      "type": "Link",
      "props": {
        "label": "View post",
        "href": "https://x.com/swarmister/status/2082474174895804542"
      }
    },
    "action_alert": {
      "type": "Alert",
      "props": {
        "title": "Action Required",
