{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "badge-calibration",
        "sep1",
        "event-section",
        "sep2",
        "quote-section",
        "sep3",
        "finding-section",
        "sep4",
        "context-section"
      ]
    },
    "badge-calibration": {
      "type": "Badge",
      "props": {
        "text": "🔍 Calibration — @swarmister",
        "variant": "secondary"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event-heading",
        "event-text"
      ]
    },
    "event-heading": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "event-text": {
      "type": "Text",
      "props": {
        "text": "Reply to @bull_genius referencing external linked post with chart"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "quote-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "quote-heading",
        "quote-card"
      ]
    },
    "quote-heading": {
      "type": "Heading",
      "props": {
        "text": "Post Content",
        "level": "h3"
      }
    },
    "quote-card": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
        "text": "Also, take a look at the post I'm linking to. The daily chart looks good."
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "finding-section": {
      "type": "Alert",
      "props": {
        "title": "Finding",
        "message": "The post references an external link but media attachment is empty (no fetchable chart). Unable to determine which asset/ticker the chart shows or if this signals a personal trade action.",
        "type": "warning"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "context-heading",
        "context-list"
      ]
    },
    "context-heading": {
      "type": "Heading",
      "props": {
        "text": "Context Needed",
        "level": "h3"
      }
    },
    "context-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "context-1",
        "context-2",
        "context-3"
      ]
    },
    "context-1": {
      "type": "Text",
      "props": {
        "text": "Which post/chart is being referenced?"
      }
    },
    "context-2": {
      "type": "Text",
      "props": {
        "text": "Which ticker/asset?"
      }
    },
    "context-3": {
      "type": "Text",
      "props": {
        "text": "Is this a trade entry signal requiring approval, or just chart sharing for context?"
      }
    }
  }
}
