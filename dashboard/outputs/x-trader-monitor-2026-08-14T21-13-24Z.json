{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor: Calibration — @trading_axe"
      },
      "children": [
        "heading_event",
        "text_event_desc",
        "separator_1",
        "tweet_card",
        "separator_2",
        "issue_section",
        "separator_3",
        "question_section"
      ]
    },
    "heading_event": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "text_event_desc": {
      "type": "Text",
      "props": {
        "text": "Reply to @beaver (context unavailable in real-time payload)",
        "variant": "body"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "trading_axe",
        "handle": "trading_axe",
        "text": "@beaver Sold this earlier after the fat move but insanely cracked team. Wouldn't be surprised if it teleports up only to ATH in the next year. ~ Dr. Axius."
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "issue_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_issue",
        "alert_issue"
      ]
    },
    "heading_issue": {
      "type": "Heading",
      "props": {
        "text": "Issue",
        "level": "h3"
      }
    },
    "alert_issue": {
      "type": "Alert",
      "props": {
        "title": "Missing Asset Context",
        "message": "No explicit ticker/asset mentioned. Post is a reply to @beaver's message, but the original context is not provided in the webhook event.",
        "type": "warning"
      }
    },
    "separator_3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "question_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_question",
        "text_question"
      ]
    },
    "heading_question": {
      "type": "Heading",
      "props": {
        "text": "What is @beaver referring to?",
        "level": "h3"
      }
    },
    "text_question": {
      "type": "Text",
      "props": {
        "text": "Unable to classify without knowing the asset discussed.",
        "variant": "muted"
      }
    }
  }
}
