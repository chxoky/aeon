{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor",
        "description": "Calibration and classification analysis"
      },
      "children": [
        "stack_header",
        "sep1",
        "stack_event",
        "sep2",
        "stack_analysis"
      ]
    },
    "stack_header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "badge_cal",
        "text_account"
      ]
    },
    "badge_cal": {
      "type": "Badge",
      "props": {
        "text": "Calibration",
        "variant": "secondary"
      }
    },
    "text_account": {
      "type": "Text",
      "props": {
        "text": "@abetrade",
        "variant": "lead"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack_event": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_event",
        "text_event_type",
        "tweet_card"
      ]
    },
    "heading_event": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "text_event_type": {
      "type": "Text",
      "props": {
        "text": "Engagement with @tradesonpoint, sharing a link"
      }
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "abetrade",
        "handle": "abetrade",
        "text": "@tradesonpoint https://t.co/LDsjBvb8mu"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack_analysis": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "alert_classify",
        "text_pattern"
      ]
    },
    "alert_classify": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "message": "What's your read?",
        "type": "info"
      }
    },
    "text_pattern": {
      "type": "Text",
      "props": {
        "text": "Pattern: abetrade frequently shares engagement/links with other traders; last tracked activity was market structure commentary on Sep 04",
        "variant": "caption"
      }
    }
  }
}
