        "text": "🔍 Calibration — @t_in_crypto",
        "level": "h2"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {}
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
