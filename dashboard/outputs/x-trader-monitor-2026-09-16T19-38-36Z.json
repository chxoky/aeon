    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "quote-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "quote-label",
        "quote-text"
      ]
    },
    "quote-label": {
      "type": "Badge",
      "props": {
        "text": "Trader Comment",
        "variant": "secondary"
      }
