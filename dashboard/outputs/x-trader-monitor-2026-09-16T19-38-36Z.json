      "children": [
        "q1",
        "q2",
        "q3",
        "q4"
      ]
    },
    "q1": {
      "type": "Text",
      "props": {
        "text": "- Is this a SHORT management window (cover opportunity)?"
      }
    },
    "q2": {
      "type": "Text",
      "props": {
        "text": "- What market catalyst makes this time-window significant?"
      }
    },
    "q3": {
      "type": "Text",
      "props": {
        "text": "- What direction does trader anticipate?"
      }
    },
    "q4": {
      "type": "Text",
      "props": {
        "text": "- Should you adjust positioning ahead of this window, or just observe?"
      }
    }
