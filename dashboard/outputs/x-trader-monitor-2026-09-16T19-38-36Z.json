      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "content-stack"
      ]
    },
    "content-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "heading-cal",
        "sep1",
        "event-section",
        "sep2",
        "quote-section",
        "sep3",
        "alert-section",
        "sep4",
        "questions-section"
      ]
    },
    "heading-cal": {
      "type": "Heading",
