{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "stack-content"
      ]
    },
    "stack-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "tweet-card",
        "separator-1",
        "chart-section",
        "tweet-link"
      ]
    },
    "tweet-card": {
      "type": "TweetCard",
      "props": {
        "author": "HeartCanHodl",
        "handle": "HeartCanHodl",
        "text": "Volatility is good. You will like it more on bitcoin next!"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "chart-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "chart-heading",
        "volatility-stat",
        "chart-note"
      ]
    },
    "chart-heading": {
      "type": "Heading",
      "props": {
        "text": "Chart Context",
        "level": "h3"
      }
    },
    "volatility-stat": {
      "type": "Stat",
      "props": {
        "label": "Korean Stocks 30-day Kospi Volatility",
        "value": "~100%",
        "trend": "up"
      }
    },
    "chart-note": {
      "type": "Text",
      "props": {
        "text": "At record (2026 peak) — bullish reading on vol extending to crypto/BTC.",
        "variant": "body"
      }
    },
    "tweet-link": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://x.com/HeartCanHodl/status/2084229304049959421"
      }
    }
  }
}
