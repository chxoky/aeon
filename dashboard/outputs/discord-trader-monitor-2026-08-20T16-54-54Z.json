    },
    "badge-a": {
      "type": "Badge",
      "props": {
        "text": "class a",
        "variant": "default"
      }
    },
    "badge-c": {
      "type": "Badge",
      "props": {
        "text": "class c",
        "variant": "default"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert-question": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "message": "What's your read? (Chart type? Asset class reference? Technical pattern?)",
        "type": "info"
      }
    }
