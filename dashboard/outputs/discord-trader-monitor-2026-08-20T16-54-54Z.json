{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor"
      },
      "children": [
        "heading-calibration",
        "sep1",
        "stack-conversation",
        "sep2",
        "alert-question"
      ]
    },
    "heading-calibration": {
      "type": "Heading",
      "props": {
        "text": "🔍 Calibration — DC: Chase — TradFi",
        "level": "h3"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack-conversation": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "member-msg",
        "chase-msg"
      ]
    },
    "member-msg": {
      "type": "Text",
