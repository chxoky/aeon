{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Calibration — @Wild_Randomness",
        "description": "x-trader-monitor"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event_section",
        "sep1",
        "tweet_card",
        "tweet_link",
        "sep2",
        "context_section",
        "sep3",
        "status_alert"
      ]
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "event_label",
        "event_badge"
      ]
    },
    "event_label": {
      "type": "Text",
      "props": {
        "text": "Event:",
        "variant": "lead"
      }
    },
    "event_badge": {
      "type": "Badge",
      "props": {
        "text": "Post celebrating past successful trade"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "Wild_Randomness",
        "handle": "Wild_Randomness",
        "text": "And oh yeah that previous call was pretty good"
      }
    },
    "tweet_link": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://t.co/HAcDw8CDv3"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "context_heading",
        "context_text"
      ]
    },
    "context_heading": {
      "type": "Heading",
      "props": {
        "text": "Context",
        "level": "h3"
      }
    },
    "context_text": {
      "type": "Text",
      "props": {
        "text": "Recent history shows NVDA July calls TP'd in profit, sidelined. This post likely references that or another recent successful trade.",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "status_alert": {
      "type": "Alert",
      "props": {
        "title": "Awaiting Calibration",
        "message": "Unable to classify — what does \"previous call\" refer to? NVDA July calls, or something else?",
        "type": "info"
      }
    }
  }
}
