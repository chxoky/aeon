{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "header",
        "event-section",
        "status-section"
      ]
    },
    "header": {
      "type": "Heading",
      "props": {
        "text": "🔍 Calibration — @swarmister",
        "level": "h2"
      }
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event-label",
        "event-type",
        "tweet"
      ]
    },
    "event-label": {
      "type": "Text",
      "props": {
        "text": "Event",
        "variant": "muted"
      }
    },
    "event-type": {
      "type": "Text",
      "props": {
        "text": "Reply to @based16z (context unknown)"
      }
    },
    "tweet": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
        "handle": "swarmister",
        "text": "That's how it is"
      }
    },
    "status-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "status-alert",
        "question"
      ]
    },
    "status-alert": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "type": "warning"
      }
    },
    "question": {
      "type": "Text",
      "props": {
        "text": "What's your read?",
        "variant": "lead"
      }
    }
  }
}
