{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Discord Trader Monitor",
        "description": "Calibration & Classification Query"
      },
      "children": [
        "section_calibration",
        "sep1",
        "section_message",
        "sep2",
        "section_context",
        "sep3",
        "section_classification"
      ]
    },
    "section_calibration": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
