{
  "root": "main_card",
  "state": {},
  "elements": {
    "main_card": {
      "type": "Card",
      "props": {
        "title": "ONDO Technical Setup",
        "description": "Analysis from @Stoiiic on X"
      },
      "children": [
        "content_stack"
      ]
    },
    "content_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "tweet_card",
        "sep1",
        "technical_section",
        "sep2",
        "levels_section",
        "sep3",
        "dependency_alert",
        "sep4",
        "footer_stack"
      ]
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "Stoiiic",
        "handle": "@Stoiiic",
        "text": "ONDO technical setup: Diagonals working in this environment so far with momentum."
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "technical_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
