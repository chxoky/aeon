      "children": [
        "pattern_heading",
        "pattern_text",
        "trader_notes_heading",
        "trader_notes_text",
        "upside_heading",
        "upside_text"
      ]
    },
    "pattern_heading": {
      "type": "Heading",
      "props": {
        "text": "Chart Pattern",
        "level": "h3"
      }
    },
    "pattern_text": {
      "type": "Text",
      "props": {
        "text": "ONDO daily chart showing descending diagonal support + consolidation."
      }
    },
    "trader_notes_heading": {
      "type": "Heading",
      "props": {
        "text": "Trader Notes",
        "level": "h3"
      }
    },
    "trader_notes_text": {
      "type": "Text",
      "props": {
        "text": "Diagonals working in this environment so far with momentum."
      }
    },
    "upside_heading": {
      "type": "Heading",
      "props": {
        "text": "Upside Conditions",
        "level": "h3"
      }
    },
    "upside_text": {
      "type": "Text",
      "props": {
        "text": "Hold diagonal support (~0.355) + acceptance above previous day high (~0.41) = looks good for more upside."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "levels_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "levels_heading",
