    "levels_heading": {
      "type": "Heading",
      "props": {
        "text": "Key Levels",
        "level": "h3"
      }
    },
    "levels_table": {
      "type": "Table",
      "props": {
        "columns": [
          "Level",
          "Price"
        ],
        "rows": [
