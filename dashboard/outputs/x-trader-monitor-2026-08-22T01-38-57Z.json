            "Previous Day High",
            "~0.41"
          ],
          [
            "Previous Month High",
            "~0.42"
          ],
          [
            "Support",
            "~0.355–0.36"
          ]
        ]
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "dependency_alert": {
      "type": "Alert",
      "props": {
        "title": "Dependency",
        "message": "BTC needs to continue ranging",
        "type": "info"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "footer_stack": {
      "type": "Stack",
