    "pattern-col": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "pattern-label",
        "pattern-badge",
        "thesis-text"
      ]
    },
    "pattern-label": {
      "type": "Text",
      "props": {
        "text": "Pattern",
        "variant": "caption"
      }
    },
    "pattern-badge": {
      "type": "Badge",
      "props": {
        "text": "HCH"
      }
    },
    "thesis-text": {
      "type": "Text",
      "props": {
        "text": "validates short thesis",
        "variant": "caption"
      }
    }
