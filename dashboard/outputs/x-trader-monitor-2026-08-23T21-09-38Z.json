        "text": "Banter ratio: ~50-60%",
        "variant": "secondary"
      }
    },
    "pattern_heading": {
      "type": "Heading",
      "props": {
        "text": "Prior Examples",
        "level": "h4"
      }
    },
    "pattern_items": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "prior1",
        "prior2"
      ]
    },
    "prior1": {
      "type": "Text",
      "props": {
        "text": "Aug 23 05:43Z \"> commence\"",
        "variant": "caption"
      }
    },
    "prior2": {
      "type": "Text",
      "props": {
        "text": "Aug 22 02:10Z \"zcash technology has suddenly improved\"",
        "variant": "caption"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "options_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "options_heading",
        "opt_a",
        "opt_b",
        "opt_c"
      ]
    },
    "options_heading": {
      "type": "Heading",
      "props": {
        "text": "Possible Interpretations",
        "level": "h3"
