      "children": [
        "event_info",
        "sep1",
        "post_section",
        "sep2",
        "context_section",
        "sep3",
        "options_section",
        "sep4",
        "alert_final"
      ]
    },
    "event_info": {
      "type": "Text",
      "props": {
        "text": "Event: Real-time X post Sun Aug 23 21:06:05 UTC",
        "variant": "caption"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "post_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "post_heading",
        "tweet_card"
      ]
