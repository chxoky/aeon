    "opt_a": {
      "type": "Text",
      "props": {
        "text": "a) Political commentary (non-financial, skip)?",
        "variant": "body"
      }
    },
    "opt_b": {
      "type": "Text",
      "props": {
        "text": "b) Bearish sentiment on $TRUMP ticker?",
        "variant": "body"
      }
    },
    "opt_c": {
      "type": "Text",
      "props": {
        "text": "c) Market banter/meme?",
        "variant": "body"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert_final": {
      "type": "Alert",
      "props": {
        "title": "Classification Needed",
        "message": "What's your read?",
