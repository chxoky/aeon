        "text": "crime on TRUMP."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "context_heading",
        "context_text",
        "banter_badge",
        "pattern_heading",
        "pattern_items"
      ]
    },
    "context_heading": {
      "type": "Heading",
      "props": {
        "text": "Context",
        "level": "h3"
      }
    },
    "context_text": {
      "type": "Text",
      "props": {
        "text": "Unable to classify — this is extremely cryptic. Stoiiic has high banter ratio (~50-60%) and established cryptic-reply pattern.",
