{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "tweet_card",
        "view_link",
        "separator",
        "image_note"
      ]
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "bull_genius",
        "handle": "@bull_genius",
        "text": "made my day!!\n\nmarmot's burrow is the #1 rising crypto substrate in the world!"
      }
    },
    "view_link": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://x.com/bull_genius/status/2099156055515140494"
      }
    },
    "separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "image_note": {
      "type": "Alert",
      "props": {
        "type": "info",
        "message": "Referenced image unavailable for analysis (sandbox CDN fetch blocked). Click link to view chart/details in browser."
      }
    }
  }
}
