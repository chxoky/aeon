{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "tweet-card",
        "sentiment-section",
        "positions-section",
        "tweet-link"
      ]
    },
    "tweet-card": {
      "type": "TweetCard",
      "props": {
        "author": "HeartCanHodl",
        "handle": "@HeartCanHodl",
        "text": "Crypto Twitter & Jim Cramer were both inversely on point today"
      }
    },
    "sentiment-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "sentiment-title",
        "sentiment-text"
      ]
    },
    "sentiment-title": {
      "type": "Heading",
      "props": {
        "text": "Sentiment read",
        "level": "h4"
      }
    },
    "sentiment-text": {
      "type": "Text",
      "props": {
        "text": "Both contrarian voices (Crypto Twitter consensus, Jim Cramer) were right about market direction today — aligned with your escalating bearish conviction"
      }
    },
    "positions-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "positions-note",
        "positions-stack"
      ]
    },
    "positions-note": {
      "type": "Text",
      "props": {
        "text": "Positions added same session:",
        "variant": "caption"
      }
    },
    "positions-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat-btc",
        "stat-eth"
      ]
    },
    "stat-btc": {
      "type": "Stat",
      "props": {
        "label": "BTC Short",
        "value": "+3%"
      }
    },
    "stat-eth": {
      "type": "Stat",
      "props": {
        "label": "ETH Short",
        "value": "+2%"
      }
    },
    "tweet-link": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://x.com/HeartCanHodl/status/2077138601268384215"
      }
    }
  }
}
