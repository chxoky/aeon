{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Discord Trader Monitor",
        "description": "Trading Signal Calibration"
      },
      "children": [
        "header",
        "stack_content"
      ]
    },
    "header": {
      "type": "Text",
      "props": {
        "text": "🔍 *Calibration — [DC: HCH — Chat]*",
        "variant": "lead"
      }
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "event_section",
        "sep1",
        "trader_comment",
        "sep2",
        "clarification"
      ]
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event_label",
        "event_details",
        "technical_label",
        "technical_details"
      ]
    },
    "event_label": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "event_details": {
      "type": "Text",
      "props": {
        "text": "Prior day (Sep 05 15:47Z) HCH closed all longs on BTC.D"
      }
    },
    "technical_label": {
      "type": "Heading",
      "props": {
        "text": "Technical Level",
        "level": "h3"
      }
    },
    "technical_details": {
      "type": "Text",
      "props": {
        "text": "Cover all spots/longs..btcdom reaching to some interesting spot"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "trader_comment": {
      "type": "TweetCard",
      "props": {
        "author": "heartcanhodl",
        "text": "Likely a slowdown"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "clarification": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "clarif_header",
        "clarif_body"
      ]
    },
    "clarif_header": {
      "type": "Heading",
      "props": {
        "text": "Unable to classify",
        "level": "h3"
      }
    },
    "clarif_body": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "message": "What does \"slowdown\" refer to? Market slowdown? BTC.D slowdown? Consolidation expected? What's your read?"
      }
    }
  }
}
