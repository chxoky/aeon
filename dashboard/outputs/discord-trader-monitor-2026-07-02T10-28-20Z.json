{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor"
      },
      "children": [
        "stack-content"
      ]
    },
    "stack-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "badge-status",
        "section-event",
        "sep-1",
        "section-actions",
        "sep-2",
        "section-hedge"
      ]
    },
    "badge-status": {
      "type": "Badge",
      "props": {
        "text": "Success",
        "variant": "default"
      }
    },
    "section-event": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading-event",
        "text-event-detail"
      ]
    },
    "heading-event": {
      "type": "Heading",
      "props": {
        "text": "Trade Execution",
        "level": "h3"
      }
    },
    "text-event-detail": {
      "type": "Text",
      "props": {
        "text": "HeartCanHodl closed majors (BTC/ETH/SOL longs) fully at 10:25:13Z in HCH — Trades channel"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section-actions": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading-actions",
        "text-alert",
