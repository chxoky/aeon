      }
    },
    "stat_consolidation": {
      "type": "Stat",
      "props": {
        "label": "Consolidation Level",
        "value": "149"
      }
    },
    "stat_downtrend": {
      "type": "Stat",
      "props": {
        "label": "3-Month Downtrend",
        "value": "300 → 140"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_analysis": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_analysis",
        "text_context",
        "heading_scenarios",
        "scenario_stack"
      ]
    },
    "heading_analysis": {
      "type": "Heading",
      "props": {
        "text": "Chart Analysis",
        "level": "h3"
      }
    },
