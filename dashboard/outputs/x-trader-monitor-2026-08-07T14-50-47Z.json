{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor",
        "description": "SOXL Position Closed – Mirrored from @Wild_Randomness"
      },
      "children": [
        "alert_action",
        "sep1",
        "section_levels",
        "sep2",
        "section_analysis",
        "sep3",
        "link_post"
      ]
    },
    "alert_action": {
      "type": "Alert",
      "props": {
        "title": "SOXL Long Position Closed",
