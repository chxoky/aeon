      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_levels": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_levels",
        "stats_grid"
      ]
    },
    "heading_levels": {
      "type": "Heading",
      "props": {
        "text": "Key Support Levels",
        "level": "h3"
      }
    },
    "stats_grid": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
