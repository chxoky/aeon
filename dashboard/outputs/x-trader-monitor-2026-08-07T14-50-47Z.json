      "type": "Text",
      "props": {
        "text": "Break below 139: Trend break invalidates structural support",
        "variant": "body"
      }
    },
    "text_hold_above": {
      "type": "Text",
      "props": {
        "text": "Hold above 149: Consolidation continues",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "link_post": {
      "type": "Link",
      "props": {
        "label": "View post on X",
        "href": "https://x.com/Wild_Randomness/status/2085739487716638887"
