{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Skill Health",
        "description": "2026-07-20"
      },
      "children": [
        "stack-main"
      ]
    },
    "stack-main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "alert-status",
        "separator1",
        "stats-row"
      ]
    },
    "alert-status": {
      "type": "Alert",
      "props": {
        "title": "HEALTH: OK",
        "message": "6 skills healthy",
        "type": "success"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stats-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat-open",
        "stat-resolved"
      ]
    },
    "stat-open": {
      "type": "Stat",
      "props": {
        "label": "Open issues",
        "value": "0"
      }
    },
    "stat-resolved": {
      "type": "Stat",
      "props": {
        "label": "Resolved this run",
        "value": "0"
      }
    }
  }
}
