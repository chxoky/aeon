{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor"
      },
      "children": [
        "heading_calibration",
        "stack_content"
      ]
    },
    "heading_calibration": {
      "type": "Heading",
      "props": {
        "text": "🔍 Calibration — [DC: Chase — TradFi]",
        "level": "h3"
      }
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "text_event",
        "separator_1",
        "stat_crypto_chase",
        "separator_2",
        "alert_classify"
      ]
    },
    "text_event": {
      "type": "Text",
      "props": {
        "text": "Event: Supporting channel message, no reply context provided",
        "variant": "body"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stat_crypto_chase": {
      "type": "Stat",
      "props": {
        "label": "crypto_chase",
        "value": "starting at 5pm today"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert_classify": {
      "type": "Alert",
      "props": {
        "message": "Unable to classify — what's your read?",
        "type": "info"
      }
    }
  }
}
