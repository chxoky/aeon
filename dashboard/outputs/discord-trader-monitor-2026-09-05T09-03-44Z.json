{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "🔍 Calibration — discord-trader-monitor",
        "description": "Discord message classification analysis"
      },
      "children": [
        "earlier-section",
        "sep-1",
        "followup-section",
