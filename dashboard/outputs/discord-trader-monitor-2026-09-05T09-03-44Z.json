    "needs-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "item-1",
        "item-2",
        "item-3",
        "item-4"
      ]
    },
    "item-1": {
      "type": "Text",
      "props": {
        "text": "1. What does \"Fc\" notation mean? (false-close check? from-chart? abbreviation?)",
        "variant": "body"
      }
    },
    "item-2": {
      "type": "Text",
      "props": {
        "text": "2. What is \"$Ake\"? (ticker? codename? asset reference?)",
        "variant": "body"
      }
    },
    "item-3": {
      "type": "Text",
      "props": {
        "text": "3. Is this technical chart notation or a new trade setup?",
        "variant": "body"
      }
    },
    "item-4": {
      "type": "Text",
      "props": {
        "text": "4. Earlier \"Fc bnb 1m\" posts (08:18Z, 08:25Z) — same pattern?",
        "variant": "body"
      }
    },
    "sep-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "metadata-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "channel-badge",
        "msg-id",
        "timestamp"
