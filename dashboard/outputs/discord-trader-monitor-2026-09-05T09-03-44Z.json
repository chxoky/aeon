    "timestamp": {
      "type": "Text",
      "props": {
        "text": "09:00:41 UTC",
        "variant": "caption"
      }
    },
    "sep-4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "question-section": {
      "type": "Alert",
      "props": {
        "title": "Classification Request",
        "message": "Your read on \"Fc Ake 1hr\"?",
        "type": "info"
      }
    }
