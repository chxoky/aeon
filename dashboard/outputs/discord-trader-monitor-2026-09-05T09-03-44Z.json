        "needs-context-section",
        "sep-3",
        "metadata-section",
        "sep-4",
        "question-section"
      ]
    },
    "earlier-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "earlier-label",
        "earlier-text"
      ]
    },
    "earlier-label": {
      "type": "Text",
      "props": {
        "text": "Earlier ambiguous:",
        "variant": "lead"
      }
    },
    "earlier-text": {
      "type": "Text",
      "props": {
        "text": "\"$Ake is upto some crime 🫆\"",
        "variant": "body"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "followup-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "followup-label",
        "followup-text"
      ]
    },
    "followup-label": {
      "type": "Text",
      "props": {
        "text": "Cryptic follow-up:",
        "variant": "lead"
      }
    },
    "followup-text": {
      "type": "Text",
      "props": {
        "text": "\"Fc ake 1hr\"",
        "variant": "body"
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "needs-context-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
