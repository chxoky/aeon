    "card": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor",
        "description": "Discord conversation from Chase — TradFi channel"
      },
      "children": [
        "channel-header",
        "separator1",
        "conversation"
      ]
    },
    "channel-header": {
