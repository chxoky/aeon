      "children": [
        "chart_trend",
        "chart_time",
        "chart_algo"
      ]
    },
    "chart_trend": {
      "type": "Text",
      "props": {
        "text": "Clean mechanical uptrend: 0.0940 → 0.12550"
      }
    },
    "chart_time": {
      "type": "Text",
      "props": {
        "text": "Full trading day: 01:00 AM – 09:00 PM"
      }
    },
    "chart_algo": {
      "type": "Text",
      "props": {
        "text": "TWAP algorithm (Time-Weighted Average Price execution) drives consistent price progression via systematic order distribution."
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
