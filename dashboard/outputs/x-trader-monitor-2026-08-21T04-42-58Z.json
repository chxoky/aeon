    "card_main": {
      "type": "Card",
      "props": {
        "title": "X-Trader Monitor"
      },
      "children": [
        "tweet_card",
        "separator_1",
        "chart_section",
        "separator_2",
        "context_section"
      ]
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "Stoiiic",
        "handle": "Stoiiic",
