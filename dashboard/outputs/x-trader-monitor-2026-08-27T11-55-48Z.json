{
  "root": "card_root",
  "state": {},
  "elements": {
    "card_root": {
      "type": "Card",
      "props": {
        "title": "Calibration — @swarmister"
      },
      "children": [
        "content_stack"
      ]
    },
    "content_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event_block",
        "sep1",
        "tweet_block",
        "sep2",
        "classification_alert"
      ]
