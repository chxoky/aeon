        "event_label",
        "event_detail"
      ]
    },
    "event_label": {
      "type": "Text",
      "props": {
        "text": "Event",
        "variant": "muted"
      }
    },
    "event_detail": {
      "type": "Text",
      "props": {
        "text": "Reply to @tienluncon610"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {}
    },
    "tweet_block": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
        "handle": "@swarmister",
        "text": "5 eth"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "classification_alert": {
      "type": "Alert",
      "props": {
        "title": "New trader detected",
        "message": "Unable to classify — what's your read? Is this a position entry, price reference, or something else?",
        "type": "info"
      }
    }
  }
