{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor",
        "description": "Calibration request"
      },
      "children": [
        "main_stack"
      ]
    },
    "main_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading",
        "sep1",
        "event_info",
        "sep2",
        "message_info",
        "sep3",
        "question_alert"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "Calibration — @Wild_Randomness",
        "level": "h2"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {}
    },
    "event_info": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event_label",
        "event_content"
      ]
    },
    "event_label": {
      "type": "Text",
      "props": {
        "text": "Event:",
        "variant": "caption"
      }
    },
    "event_content": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "unknown_text",
        "trader_badge"
      ]
    },
    "unknown_text": {
      "type": "Text",
      "props": {
        "text": "Unknown"
      }
    },
    "trader_badge": {
      "type": "Badge",
      "props": {
        "text": "new trader",
        "variant": "secondary"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "message_info": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "message_label",
        "message_text"
      ]
    },
    "message_label": {
      "type": "Text",
      "props": {
        "text": "@Wild_Randomness:",
        "variant": "caption"
      }
    },
    "message_text": {
      "type": "Text",
      "props": {
        "text": "\"Re\""
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {}
    },
    "question_alert": {
      "type": "Alert",
      "props": {
        "title": "Classification needed",
        "message": "Unable to classify — what's your read?",
        "type": "info"
      }
    }
  }
}
