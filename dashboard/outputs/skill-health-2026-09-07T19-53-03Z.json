{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Skill Health"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "text_date",
        "alert_health",
        "stack_metrics"
      ]
    },
    "text_date": {
      "type": "Text",
      "props": {
        "text": "2026-09-07",
        "variant": "caption"
      }
    },
    "alert_health": {
      "type": "Alert",
      "props": {
        "message": "HEALTH: OK",
        "type": "success"
      }
    },
    "stack_metrics": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat_healthy",
        "stat_open",
        "stat_resolved"
      ]
    },
    "stat_healthy": {
      "type": "Stat",
      "props": {
        "label": "Skills Healthy",
        "value": "8"
      }
    },
    "stat_open": {
      "type": "Stat",
      "props": {
        "label": "Open Issues",
        "value": "0"
      }
    },
    "stat_resolved": {
      "type": "Stat",
      "props": {
        "label": "Resolved This Run",
        "value": "0"
      }
    }
  }
}
