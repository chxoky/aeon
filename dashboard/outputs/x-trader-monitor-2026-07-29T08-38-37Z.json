    "link-view-tweet": {
      "type": "Link",
      "props": {
        "label": "View tweet",
        "href": "https://x.com/swarmister/status/2082384094697025996"
      }
    },
    "text-interpretation": {
      "type": "Text",
      "props": {
        "text": "Neutral range view contrasts with prior long-lean bias; aligns with group consensus of HTF-bullish but near-term chop expected.",
        "variant": "caption"
      }
    }
  }
