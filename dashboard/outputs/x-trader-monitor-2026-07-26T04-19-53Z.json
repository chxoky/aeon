        "badge-current-phase",
        "heading-sentiment",
        "text-sentiment",
        "link-post"
      ]
    },
    "heading-prices": {
      "type": "Heading",
      "props": {
        "text": "Price Levels",
        "level": "h3"
      }
    },
    "stack-prices": {
