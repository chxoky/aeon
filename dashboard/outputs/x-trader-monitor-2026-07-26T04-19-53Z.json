      }
    },
    "stat-target": {
      "type": "Stat",
      "props": {
        "label": "Re-accumulation Target",
        "value": "$80-112K"
      }
    },
    "heading-phases": {
      "type": "Heading",
      "props": {
        "text": "Chart Progression Phases",
        "level": "h3"
      }
    },
    "text-phase-progression": {
