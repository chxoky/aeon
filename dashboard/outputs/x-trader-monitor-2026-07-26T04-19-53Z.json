{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "stack-main"
      ]
    },
    "stack-main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "tweet-card",
        "sep-1",
        "breakdown-section"
      ]
    },
    "tweet-card": {
      "type": "TweetCard",
      "props": {
        "author": "KillaXBT",
        "handle": "KillaXBT",
        "text": "BTC market cycle analysis: currently in distribution phase (~64-65K). Chart progression shows: re-distribution → distribution → manipulation (current) → accumulation → re-accumulation target (~80-112K).\n\n\"I hope you are enjoying the shitty $BTC PA while it lasts\" — sarcastic on current chop, bullish conviction on upcoming re-accumulation leg."
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "breakdown-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-prices",
        "stack-prices",
        "heading-phases",
