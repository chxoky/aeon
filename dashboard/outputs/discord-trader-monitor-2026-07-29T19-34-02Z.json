        "variant": "body"
      }
    },
    "text-q2": {
      "type": "Text",
      "props": {
        "text": "• Conviction shift on active position?",
        "variant": "body"
      }
    },
    "text-q3": {
      "type": "Text",
      "props": {
        "text": "• Technical analysis waiting on chart context?",
        "variant": "body"
      }
    },
    "sep-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text-final": {
      "type": "Text",
      "props": {
        "text": "Your read?",
        "variant": "lead"
      }
    }
