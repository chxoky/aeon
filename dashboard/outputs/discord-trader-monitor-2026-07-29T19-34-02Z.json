      "type": "Card",
      "props": {
        "title": "🔍 Calibration — DC: HCH (Chat)"
      },
      "children": [
        "text-context",
        "sep-1",
        "text-speaker",
        "tweet-message",
        "sep-2",
        "alert-unable",
        "stack-questions",
        "sep-3",
        "text-final"
