{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor",
        "description": "Calibration — [DC: Chase — TradFi]"
      },
      "children": [
        "event-section",
        "sep-1",
        "message-section",
        "sep-2",
        "context-section",
        "sep-3",
        "analysis-section",
        "sep-4",
        "clarification-section"
      ]
    },
    "event-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event-heading",
        "event-text"
      ]
    },
    "event-heading": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h2"
      }
    },
    "event-text": {
      "type": "Text",
      "props": {
        "text": "Discord message from Crypto_Chase in member Q&A channel"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "message-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "message-heading",
        "message-text"
      ]
    },
    "message-heading": {
      "type": "Heading",
      "props": {
        "text": "Message",
        "level": "h2"
      }
    },
    "message-text": {
      "type": "Text",
      "props": {
        "text": "\"They didn't wait for the close\""
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "context-heading",
        "context-main",
        "context-positions"
      ]
    },
    "context-heading": {
      "type": "Heading",
      "props": {
        "text": "Context",
        "level": "h2"
      }
    },
    "context-main": {
      "type": "Text",
      "props": {
        "text": "Chase just posted a risk-management reminder in the primary channel (13:55 UTC) expressing confidence in current trades. This follow-up message in the TradFi supporting channel is unclear — unable to determine who \"they\" refers to or what position/market situation prompted the comment."
      }
    },
    "context-positions": {
      "type": "Text",
      "props": {
        "text": "Recent long positions: SNDK @1366, MU ~800, SPX/ES long conviction"
      }
    },
    "sep-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "analysis-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "analysis-heading",
        "analysis-badge"
      ]
    },
    "analysis-heading": {
      "type": "Heading",
      "props": {
        "text": "Status",
        "level": "h2"
      }
    },
    "analysis-badge": {
      "type": "Badge",
      "props": {
        "text": "Unable to classify",
        "variant": "destructive"
      }
    },
    "sep-4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "clarification-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "clarification-heading",
        "options-stack",
        "clarification-alert"
      ]
    },
    "clarification-heading": {
      "type": "Heading",
      "props": {
        "text": "Possible Interpretations",
        "level": "h3"
      }
    },
    "options-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "opt-1",
        "opt-2",
        "opt-3",
        "opt-4"
      ]
    },
    "opt-1": {
      "type": "Text",
      "props": {
        "text": "1. Commentary on market participants exiting positions early?",
        "variant": "body"
      }
    },
    "opt-2": {
      "type": "Text",
      "props": {
        "text": "2. Reference to a specific trade/setup discussed in the channel?",
        "variant": "body"
      }
    },
    "opt-3": {
      "type": "Text",
      "props": {
        "text": "3. Observation about market action/price movement?",
        "variant": "body"
      }
    },
    "opt-4": {
      "type": "Text",
      "props": {
        "text": "4. Something related to one of the recent long positions?",
        "variant": "body"
      }
    },
    "clarification-alert": {
      "type": "Alert",
      "props": {
        "title": "Clarification Needed",
        "message": "Please clarify what this refers to.",
        "type": "info"
      }
    }
  }
}
