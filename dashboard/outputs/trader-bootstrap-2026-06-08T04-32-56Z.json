{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Trader Bootstrap",
        "description": "3-day lookback (2026-06-05 → 06-08)"
      },
      "children": [
        "note-x-history",
        "separator-1",
        "section-positions",
        "separator-2",
        "section-overlap",
        "separator-3",
        "section-theses",
        "separator-4",
        "note-monitoring"
      ]
    },
    "note-x-history": {
      "type": "Alert",
      "props": {
        "type": "info",
        "message": "X history was empty this run (no tweets cached); state below is from 331 Discord messages across Crypto_Chase, KillaXBT, and HeartCanHodl."
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section-positions": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-positions",
        "crypto-chase-section",
        "killaxbt-section",
        "heartcanhodl-section"
      ]
    },
    "heading-positions": {
      "type": "Heading",
      "props": {
        "text": "Currently Live Setups/Positions",
        "level": "h2"
      }
    },
    "crypto-chase-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading-chase",
        "chase-gold",
        "chase-hype",
        "chase-nvda",
        "chase-sentiment"
      ]
    },
    "heading-chase": {
      "type": "Heading",
      "props": {
        "text": "Crypto_Chase",
        "level": "h3"
      }
    },
    "chase-gold": {
      "type": "Text",
      "props": {
        "text": "GOLD long (spot, still open, stop not hit)"
      }
    },
    "chase-hype": {
      "type": "Text",
      "props": {
        "text": "HYPE flat — stopped -1.5R, all re-bids cancelled, eyeing low-50s"
