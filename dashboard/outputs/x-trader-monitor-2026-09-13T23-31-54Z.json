{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor Calibration",
        "description": "🔍 Awaiting classification — @Bitcoin_Astro"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event_section",
        "separator_1",
        "tweet_section",
        "separator_2",
        "issue_alert"
      ]
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event_heading",
        "event_text"
      ]
    },
    "event_heading": {
      "type": "Heading",
      "props": {
        "text": "Event",
        "level": "h3"
      }
    },
    "event_text": {
      "type": "Text",
      "props": {
        "text": "Reply to @tristanqcolt and @chartinspect"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "tweet_section": {
      "type": "TweetCard",
      "props": {
        "author": "Bitcoin_Astro",
        "handle": "@Bitcoin_Astro",
        "text": "Very likely we test those levels"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "issue_alert": {
      "type": "Alert",
      "props": {
        "title": "Unable to Classify",
        "message": "Unclear what price levels or asset is being referenced. Context of original tweets unknown. Awaiting your read.",
        "type": "warning"
      }
    }
  }
}
