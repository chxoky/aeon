        "variant": "secondary"
      }
    },
    "badge-3": {
      "type": "Badge",
      "props": {
        "text": "EMA50 crossover signal?",
        "variant": "secondary"
      }
    },
    "no-execution-note": {
      "type": "Text",
      "props": {
        "text": "No execution language.",
