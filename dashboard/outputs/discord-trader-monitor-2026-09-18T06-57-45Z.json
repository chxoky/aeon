        "variant": "outline"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "context-text",
        "observation-text"
      ]
    },
    "context-text": {
      "type": "Text",
      "props": {
