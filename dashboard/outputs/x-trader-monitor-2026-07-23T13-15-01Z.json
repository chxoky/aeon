      "props": {
        "label": "HYPE",
        "value": "+0.52%",
        "trend": "up"
      }
    },
    "stat_btc": {
      "type": "Stat",
      "props": {
        "label": "BTC",
        "value": "-1.65%",
        "trend": "down"
      }
    },
    "stat_eth": {
      "type": "Stat",
      "props": {
        "label": "ETH",
        "value": "-1.84%",
        "trend": "down"
      }
    },
    "stat_sol": {
      "type": "Stat",
      "props": {
        "label": "SOL",
        "value": "-1.55%",
        "trend": "down"
      }
    }
  }
}
