        "msg_label",
        "msg_badge"
      ]
    },
    "msg_label": {
      "type": "Text",
      "props": {
        "text": "Message:",
        "variant": "caption"
      }
    },
    "msg_badge": {
      "type": "Badge",
      "props": {
        "text": "Fc btc 1hr",
        "variant": "outline"
      }
    },
    "sep": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "message": "What's your read? (Fc = filled confirmation? forecast? chart check? force close?)",
        "type": "warning"
      }
    }
  }
}
