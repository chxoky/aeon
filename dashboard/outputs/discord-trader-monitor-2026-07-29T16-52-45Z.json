{
  "root": "card-monitor",
  "state": {},
  "elements": {
    "card-monitor": {
      "type": "Card",
      "props": {
        "title": "Discord Trader Monitor"
      },
      "children": [
        "heading-calibration",
        "pattern-section",
        "separator1",
        "findings-section",
        "separator2",
        "questions-section",
        "separator3",
        "context-section",
        "callout"
      ]
    },
    "heading-calibration": {
      "type": "Heading",
      "props": {
        "text": "Calibration — DC: HCH — Chat",
        "level": "h2"
      },
      "children": []
    },
    "pattern-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "pattern-label",
        "pattern-value"
      ]
    },
    "pattern-label": {
      "type": "Text",
      "props": {
        "text": "Pattern:",
        "variant": "lead"
