    "questions-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "questions-title",
        "q1",
        "q2"
      ]
    },
    "questions-title": {
      "type": "Text",
      "props": {
        "text": "Questions for calibration:",
        "variant": "lead"
      },
      "children": []
    },
    "q1": {
      "type": "Text",
      "props": {
        "text": "What does 'Fc' stand for?"
      },
      "children": []
    },
    "q2": {
      "type": "Text",
      "props": {
        "text": "Form-confirmed? Technical observation only? Signal to add/cover?"
      },
      "children": []
    },
    "separator3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "context-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "context-title",
        "context1",
        "context2"
      ]
    },
    "context-title": {
      "type": "Text",
      "props": {
