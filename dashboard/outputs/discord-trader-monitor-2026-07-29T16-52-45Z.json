      },
      "children": []
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "findings-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "finding1",
        "finding2"
      ]
    },
    "finding1": {
      "type": "Text",
      "props": {
        "text": "HCH has posted this exact 'Fc {ticker} {timeframe}' pattern 7+ times (Jul 24–29)"
