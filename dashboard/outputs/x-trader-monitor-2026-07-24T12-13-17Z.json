{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_calib",
        "sep1",
        "text_event",
        "tweet_card",
        "sep2",
        "text_pattern",
        "alert_classify"
      ]
    },
    "heading_calib": {
      "type": "Heading",
      "props": {
        "text": "🔍 Calibration — @swarmister",
        "level": "h3"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text_event": {
      "type": "Text",
      "props": {
        "text": "Event: Reply to @FalconyFalcon"
      }
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
        "handle": "swarmister",
        "text": "@FalconyFalcon Lmeow"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text_pattern": {
      "type": "Text",
      "props": {
        "text": "Pattern: Multiple terse replies to FalconyFalcon (prior \"@FalconyFalcon Pls\" awaiting calibration). One-word replies from swarmister are typically non-financial banter per conviction notes (~80% social posts).",
        "variant": "body"
      }
    },
    "alert_classify": {
      "type": "Alert",
      "props": {
        "title": "Classification Uncertain",
        "message": "Unable to classify — is this signal/execution language or noise?",
        "type": "warning"
      }
    }
  }
}
