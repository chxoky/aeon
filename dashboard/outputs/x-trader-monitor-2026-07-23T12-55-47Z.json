{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "header_stack",
        "sep1",
        "event_text",
        "sep2",
        "tweet_card",
        "sep3",
        "analysis_alert"
      ]
    },
    "header_stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_calib",
        "heading_author"
      ]
    },
    "badge_calib": {
      "type": "Badge",
      "props": {
        "text": "Calibration",
        "variant": "secondary"
      }
    },
    "heading_author": {
      "type": "Heading",
      "props": {
        "text": "@swarmister",
        "level": "h3"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "event_text": {
      "type": "Text",
      "props": {
        "text": "Event: reply context unknown",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "tweet_card": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
        "text": "@kingbtc Jintao what"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "analysis_alert": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "title": "Unable to classify",
        "message": "Is this financial/actionable, or social banter? Pattern: swarmister posts many cryptic minimal replies; this matches that pattern, but unclear if it's a market signal about these traders or pure social"
      }
    }
  }
}
