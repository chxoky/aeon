{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "discord-trader-monitor",
        "description": "🔍 Calibration — DC: Chase — TradFi"
      },
      "children": [
        "stack-content"
      ]
    },
    "stack-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "event-metadata",
        "message-card",
        "sep1",
        "classification-section"
      ]
    },
    "event-metadata": {
      "type": "Text",
      "props": {
        "text": "Event: supporting channel message, no prior context provided",
        "variant": "caption"
      }
    },
    "message-card": {
      "type": "TweetCard",
      "props": {
        "author": "Crypto_Chase",
        "text": "This is still sort of my memory thought but I don't know. It's tough to tell at the moment"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "classification-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "alert-unable",
        "questions-stack"
      ]
    },
    "alert-unable": {
      "type": "Alert",
      "props": {
        "title": "Unable to classify",
        "type": "warning"
      }
    },
    "questions-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "q1",
        "q2"
      ]
    },
    "q1": {
      "type": "Text",
      "props": {
        "text": "What's your read?",
        "variant": "body"
      }
    },
    "q2": {
      "type": "Text",
      "props": {
        "text": "What 'memory thought' is being referenced?",
        "variant": "body"
      }
    }
  }
}
