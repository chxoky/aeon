        "level": "h4"
      }
    },
    "btc-price": {
      "type": "Stat",
      "props": {
        "label": "BTC currently",
        "value": "~$77.2K"
      }
    },
    "upside-potential": {
      "type": "Stat",
      "props": {
        "label": "Upside to 120K level",
        "value": "~55%",
        "trend": "up"
      }
