        "view-post-link"
      ]
    },
    "event-heading": {
      "type": "Heading",
      "props": {
        "text": "Event: Morning market sentiment post",
        "level": "h3"
      }
    },
    "tweet-card": {
      "type": "TweetCard",
      "props": {
        "author": "swarmister",
