{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "x-trader-monitor"
      },
      "children": [
        "tweet-stack",
        "separator",
        "context-stack"
      ]
    },
    "tweet-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "tweet",
        "tweet-link"
      ]
    },
    "tweet": {
      "type": "TweetCard",
      "props": {
        "author": "Stoiiic",
        "handle": "@Stoiiic",
        "text": "It's Grant's fault."
      }
    },
    "tweet-link": {
      "type": "Link",
      "props": {
        "label": "View on X",
        "href": "https://x.com/Stoiiic/status/2080689353634750957"
      }
    },
    "separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "context-heading",
        "sentiment-text",
        "price-comparison",
        "details-text"
      ]
