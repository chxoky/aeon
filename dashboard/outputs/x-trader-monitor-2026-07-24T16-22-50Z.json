      }
    },
    "btc-current": {
      "type": "Stat",
      "props": {
        "label": "BTC Current (Jul 24)",
        "value": "$63–64K",
        "delta": "-4.2%",
        "trend": "down"
      }
    },
    "details-text": {
      "type": "Text",
      "props": {
        "text": "Grant Cardone screenshot shown with price action chart.",
